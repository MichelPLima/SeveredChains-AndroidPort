@@ -0,0 +1,42 @@
+package legend.core.platform;
+
+import legend.core.Config;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import java.util.Locale;
+
+/**
+ * Which graphics API the window should create a context for.
+ *
+ * <p>Read from the {@code sc.renderer} system property first (e.g. {@code -Dsc.renderer=gles}), then from {@code renderer} in config.conf.</p>
+ */
+public enum RendererMode {
+  /** Try OpenGL 3.3 first, then fall back to OpenGL ES 3.2 */
+  AUTO,
+  /** OpenGL 3.3 only */
+  GL,
+  /** OpenGL ES 3.2 only */
+  GLES,
+  ;
+
+  private static final Logger LOGGER = LogManager.getFormatterLogger(RendererMode.class);
+
+  public static final String PROPERTY = "sc.renderer";
+
+  public static RendererMode get() {
+    final String property = System.getProperty(PROPERTY);
+    final String value = property != null ? property : Config.renderer();
+
+    if(value == null || value.isBlank()) {
+      return AUTO;
+    }
+
+    try {
+      return valueOf(value.trim().toUpperCase(Locale.ROOT));
+    } catch(final IllegalArgumentException e) {
+      LOGGER.warn("Unknown renderer \"%s\" (expected auto, gl or gles), using auto", value);
+      return AUTO;
+    }
+  }
+}
