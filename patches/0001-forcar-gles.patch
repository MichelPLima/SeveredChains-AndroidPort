+  /** renderer=gl: OpenGL 3.3 only, no fallback */
+  private boolean createForcedOpenGlWindow(final String title, final int width, final int height, final long[] windowRef, final long[] contextRef) {
+    LOGGER.info("Initializing OpenGL 3.3 (forced)...");
+    this.createGlWindow(title, width, height, SDL_GL_CONTEXT_PROFILE_CORE, 3, 3, windowRef, contextRef);
+
+    if(windowRef[0] == NULL) {
+      return false;
+    }
+
+    if(!GL.createCapabilities().OpenGL33) {
+      LOGGER.warn("OpenGL 3.3 is not supported");
+      this.destroyGlWindow(windowRef, contextRef);
+      return false;
+    }
+
+    return true;
+  }
+
+  /**
+   * renderer=gles: OpenGL ES 3.2 only, no fallback.
+   *
+   * <p>By default LWJGL loads GLES functions from libGLESv2 (ANGLE naming), which doesn't exist on most desktops even when the driver can create an ES
+   * context (e.g. WGL_EXT_create_context_es2_profile). Ask SDL for the function addresses instead, which works with WGL, GLX, EGL, ANGLE and Android.</p>
+   */
+  private boolean createForcedOpenGlesWindow(final String title, final int width, final int height, final long[] windowRef, final long[] contextRef) {
+    LOGGER.info("Initializing OpenGLES 3.2 (forced)...");
+
+    // Must be set before the GLES class is initialized, otherwise it tries to load libGLESv2 itself
+    Configuration.OPENGLES_EXPLICIT_INIT.set(true);
+
+    this.createGlWindow(title, width, height, SDL_GL_CONTEXT_PROFILE_ES, 3, 2, windowRef, contextRef);
+
+    if(windowRef[0] == NULL) {
+      return false;
+    }
+
+    GLES.create(SDLVideo::SDL_GL_GetProcAddress);
+
+    if(!GLES.createCapabilities().GLES32) {
+      LOGGER.warn("OpenGLES 3.2 is not supported");
+      this.destroyGlWindow(windowRef, contextRef);
+      return false;
+    }
+
+    return true;
+  }
+
+  private void destroyGlWindow(final long[] windowRef, final long[] contextRef) {
+    SDL_GL_DestroyContext(contextRef[0]);
+    SDL_DestroyWindow(windowRef[0]);
+    windowRef[0] = NULL;
+    contextRef[0] = NULL;
+  }
+
   private void createGlWindow(final String title, final int width, final int height, final int profile, final int majorVersion, final int minorVersion, final long[] windowRef, final long[] contextRef) {
     windowRef[0] = NULL;
     contextRef[0] = NULL;
