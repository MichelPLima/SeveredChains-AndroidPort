index 000000000..e97dad88f
--- /dev/null
+++ b/src/main/java/legend/core/platform/AndroidPort.java
@@ -0,0 +1,32 @@
+package legend.core.platform;
+
+import legend.core.Version;
+
+/**
+ * Identity of the Android port (SeveredChains-Android) in the game's UI and logs.
+ *
+ * <p>The internal version stays {@link Version#VERSION}, because mods check compatibility against it; only the text shown to the
+ * player changes. The Android app passes {@code -Dsc.android.version} (its own version) and {@code -Dsc.android.reportUrl} (the
+ * port's issue tracker), so problems found on Android don't go to the Severed Chains team.</p>
+ */
+public final class AndroidPort {
+  private AndroidPort() { }
+
+  public static boolean isAndroid() {
+    return "android".equals(System.getProperty("sc.platform"));
+  }
+
+  /** "3.0.0 - Android 0.6.0" on Android, {@link Version#FULL_VERSION} elsewhere */
+  public static String displayVersion() {
+    if(!isAndroid()) {
+      return Version.FULL_VERSION;
+    }
+
+    return Version.VERSION + " - Android " + System.getProperty("sc.android.version", "?");
+  }
+
+  /** The port's issue tracker on Android, null elsewhere */
+  public static String reportUrl() {
+    return isAndroid() ? System.getProperty("sc.android.reportUrl") : null;
+  }
+}
