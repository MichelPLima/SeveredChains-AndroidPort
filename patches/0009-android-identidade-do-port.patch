+
+  /** Where to send the crash log: the Severed Chains Discord, or the Android port's issue tracker on Android */
+  private static void reportCrash() {
+    final String reportUrl = AndroidPort.reportUrl();
+
+    if(reportUrl != null) {
+      LOGGER.error("This is the unofficial Android port of Severed Chains. Please don't report it to the Severed Chains team.");
